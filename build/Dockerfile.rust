# Rust implementation (rust-blinkt/): build the blinkt5 binary natively on the build platform and cross-compile a
# fully static musl binary for the target (no QEMU emulation): rust-lld links
# musl's self-contained runtime for both aarch64 and x86_64.
FROM --platform=$BUILDPLATFORM rust:1.99-bookworm AS builder
ARG TARGETARCH
WORKDIR /workspace
RUN case "$TARGETARCH" in \
      arm64) echo aarch64-unknown-linux-musl ;; \
      amd64) echo x86_64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac > /triple && rustup target add "$(cat /triple)"
COPY rust-blinkt/Cargo.toml rust-blinkt/Cargo.lock rust-blinkt/rust-toolchain.toml ./
COPY rust-blinkt/src/ src/
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/workspace/target,id=blinkt-target-${TARGETARCH} \
    T="$(cat /triple)" && \
    RUSTFLAGS="-C linker=rust-lld -C target-feature=+crt-static" \
      cargo build --release --locked --target "$T" --bin blinkt5 && \
    cp "target/$T/release/blinkt5" /blinkt5

FROM scratch
WORKDIR /
ADD build/etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /blinkt5 /blinkt5
CMD ["/blinkt5"]
