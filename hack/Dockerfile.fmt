# Formats the crate, refreshes Cargo.lock, and exports both back to the host (hack/fmt.sh).
FROM rust:1.99-bookworm AS fmt
WORKDIR /src
COPY . .
WORKDIR /src/rust-blinkt
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    rustup component add rustfmt >/dev/null 2>&1 && cargo fmt && cargo fetch
FROM scratch
COPY --from=fmt /src/rust-blinkt/src /rust-blinkt/src
COPY --from=fmt /src/rust-blinkt/examples /rust-blinkt/examples
COPY --from=fmt /src/rust-blinkt/Cargo.lock /rust-blinkt/Cargo.lock
