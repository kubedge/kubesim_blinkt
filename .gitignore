
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
build/_output/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
.DS_Store
._*
*.swp
*.swo
*~

# Rust
/target/
/rust-blinkt/target/

# blinkt-operator tool binaries
/blinkt-operator/bin/

# Environment / secrets — NEVER commit
.env
.env.*
!.env.example

# Python (plugins/alemax, bin/*.py)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Operator scratch (never committed)
/.local/
prototypes/

# Claude Code operator-local settings (per-operator, never committed). Reconciled
# against the tracked floor .claude/settings-template.json by bin/reconcile-settings.py,
# which creates the file by hand — so this line, not Claude Code's global exclude,
# keeps it out of git. This repo never tracks a .claude/settings.json.
.claude/settings.local.json

# Claude Code worktrees (`claude --worktree`, subagent isolation) — inside a session's scope,
# never committed (spec sibling-access-practice)
.claude/worktrees/
